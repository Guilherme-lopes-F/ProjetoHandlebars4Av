<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar informações das Entradas</title>
  <link rel="stylesheet" href="/css/cardapio/editarCardapio.css">
</head>
<body>
  <h1>Editar Entradas</h1>

<form action="/entrada/{{entrada.id}}/editar" method="POST">
  <label>Nome:</label>
  <input type="text" name="nome" value="{{entrada.nome}}" required><br>

  <label>Ingredientes:</label>
  <input type="text" name="ingredientes" value="{{entrada.ingredientes}}"><br>

  <label>preco:</label>
  <input type="email" name="preco" value="{{entrada.preco}}"><br>

  <button type="submit" class="submit">Salvar</button>
</form>

<a href="/cardapio" class="voltar">Voltar</a>
</body>
</html>


