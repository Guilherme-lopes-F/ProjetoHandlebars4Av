<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/ListarCliente.css">i
</head>
<body>

  <h1>Lista de Clientes</h1>
  <a href="/cliente/cadastrar">Cadastrar novo cliente</a>
  <div class="tabela">
<table border="1" cellpadding="5">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Telefone</th>
      <th>Email</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody class="corpo">
    {{#each clientes}}
    <tr>
      <td>{{id}}</td>
      <td><a href="/cliente/{{id}}">{{nome}}</a></td>
      <td>{{telefone}}</td>
      <td>{{email}}</td>
      <td>
        <a href="/cliente/{{id}}/editar">Editar</a>
        <form action="/cliente/{{id}}/deletar" method="POST" style="display:inline;">
          <button type="submit">Deletar</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
<a href="/">Voltar</a>

</body>
</html>







