<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/cardapiodef/listar.css">
</head>
<body>

<h1>Entrada</h1>
  <div class="formato">
    {{#each entradas}}
    <div class="card">

      <h3><a href="/entrada/{{id}}">{{nome}}</a></h3>
      <p><b>Ingredientes:</b> {{ingredientes}}</p>
      <p><b>Preço:</b> R$ {{preco}}</p>
    </div>
  {{/each}}
  </div>

<h1>Prato Principal</h1>
  <div class="formato">
    {{#each pratosPrincipais}}
    <div class="card">

      <h3><a href="/pratoPrincipal/{{id}}">{{nome}}</a></h3>
      <p><b>Ingredientes:</b> {{ingredientes}}</p>
      <p><b>Preço:</b> R$ {{preco}}</p>
    </div>
  {{/each}}
  </div>


<h1>Sobremesas</h1>
  <div class="formato">
    {{#each sobremesas}}
    <div class="card">

      <h3><a href="/Sobremesa/{{id}}">{{nome}}</a></h3>
      <p><b>Ingredientes:</b> {{ingredientes}}</p>
      <p><b>Preço:</b> R$ {{preco}}</p>
    </div>
  {{/each}}
  </div>




</body>
</html>


